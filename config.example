# P2P Storage Node Configuration

# Listen address - the port this node will bind to
# Format: :PORT or IP:PORT
# Default: :3000
listen=:3000

# Database path - where to store peer and file metadata
# Supports ~ for home directory
# Default: ~/.p2p/p2p.db
db=~/.p2p/p2p.db

# Bootstrap nodes - comma-separated list of initial peers to connect to
# Leave empty for standalone/bootstrap nodes
# Examples:
#   Single node:    bootstrap=localhost:4000
#   Multiple nodes: bootstrap=192.168.1.100:3000,192.168.1.101:3000,bootstrap.example.com:3000
#   Named peer:     bootstrap=<node-id>@192.168.1.100:3000
#
# The named form also checks that whoever answers is the node you meant, and
# it is required on the libp2p transport (see transport below).
#
# For production networks, specify 2-3 stable bootstrap nodes:
bootstrap=

# Network transport - "libp2p" (default) or "tcp".
#
# The two are not interoperable: every node on a network must use the same
# one. On libp2p (TCP and QUIC, Noise-encrypted), identity is proven by the
# connection itself, and bootstrap entries must therefore say who they name:
# use the id@host:port form (get the id from 'p2p node' on that machine), or
# a full multiaddr. A network built before the default changed keeps working
# by setting transport=tcp.
# transport=libp2p

# Local-network discovery - announce this node and list peers found nearby.
# Needs transport=libp2p.
#
# Discovered peers only become visible and approvable; nothing connects until
# you approve a peer ('p2p trust add' or the web UI), and approving is what
# connects it. Two machines with discovery on find each other with no
# addresses configured anywhere.
# discover=true

# Replication target - how many copies of each file the network should hold,
# counting this node's own. Files below it are repaired automatically.
# Default: 3
# replicas=3

# Local web UI - address to serve it on. Empty means off, which is the default.
#
# Off by default deliberately: the UI can approve and revoke peers, so it grants
# more than any other interface this node has. Keep it on loopback and reach it
# over an SSH tunnel for a headless machine:
#
#   ssh -N -L 7654:127.0.0.1:7654 user@host
#
# http=127.0.0.1:7654

# Allow binding the web UI somewhere other than loopback.
#
# A separate setting so exposing the UI is always a second, deliberate decision.
# When set, callers must present the token written to http-token beside the
# database. Prefer the SSH tunnel above.
# http_exposed=false

# ========================================
# Example Configurations
# ========================================

# Configuration 1: Bootstrap Node (First node in network)
# listen=:3000
# db=~/.p2p/p2p.db
# bootstrap=

# Configuration 2: Regular Node (Connects to existing network)
# listen=:3000
# db=~/.p2p/p2p.db
# bootstrap=localhost:3000,localhost:4000

# Configuration 3: Production Node
# listen=:3000
# db=~/.p2p/p2p.db
# bootstrap=bootstrap1.example.com:3000,bootstrap2.example.com:3000
